FrameWidgetClass DZKOTHG_DeathBackdrop {
 visible 1
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority -50
 {
  ImageWidgetClass DZKOTHG_DeathBackground {
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   image0 "DeutschZ_MenuMusic/gui/deathscreen_v1/01_backgrounds/deathscreen_background_2560x1440.paa"
   mode blend
   "src alpha" 1
   "stretch mode" stretch_w_h
  }
  ImageWidgetClass DZKOTHG_DeathLogo {
   position 0.055 0.08
   size 0.18 0.32
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   image0 "DeutschZ_MenuMusic/gui/menu_assets/logos/Logo_Dark.paa"
   mode blend
   "src alpha" 1
   "stretch mode" stretch_w_h
  }
  TextWidgetClass DZKOTHG_DeathTitle {
   position 0.29 0.12
   size 0.55 0.09
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text "DEIN RUN IST BEENDET"
   font "gui/fonts/sdf_MetronBook42"
   color 0.52 0.94 0.08 1
   "text halign" center
   "text valign" center
  }
  TextWidgetClass DZKOTHG_DeathSubtitle {
   position 0.31 0.215
   size 0.51 0.05
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text "CHERNARUS VERGISST NICHT. DEUTSCHZ AUCH NICHT."
   font "gui/fonts/sdf_MetronBook20"
